# ==========================================
# MediAI Telehealth - Environment Variables
# ==========================================

# Django Security
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DEBUG=False

# Database (Leave blank for SQLite locally, or provide PostgreSQL URL on Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Diagnostic Engine
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# Production Email SMTP Configuration
# ==========================================
# Choose either Option 1 (Gmail App Password) or Option 2 (Brevo / SendGrid)

# --- OPTION 1: GMAIL SMTP ---
# Generate an App Password in your Google Account:
# https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=MediAI Clinical Health <your-email@gmail.com>

# --- OPTION 2: BREVO (Formerly Sendinblue - 300 free emails/day) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login@smtp-brevo.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=MediAI Health <your-email@domain.com>
